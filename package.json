{
  "name": "plantin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sprites:sheet": "tsx --tsconfig tsconfig.app.json scripts/render-sprite-sheet.tsx",
    "assets:guides": "tsx scripts/assets/make-guides.ts",
    "assets:prompts": "tsx scripts/assets/make-prompts.ts",
    "assets:process": "tsx scripts/assets/process.ts",
    "assets:manifest": "tsx scripts/assets/build-manifest.ts",
    "assets": "npm run assets:process && npm run assets:manifest",
    "assets:render": "tsx scripts/assets/render-all.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "uuidv7": "^1.2.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
